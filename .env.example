# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_ to the browser.
# Never put private keys or seed phrases here: everything with VITE_ ends up in the client bundle.

# RPC endpoints
VITE_RPC_URL_LOCAL=http://127.0.0.1:8545
VITE_RPC_URL_SEPOLIA=
VITE_RPC_URL_MAINNET=

# Etherscan-compatible API (transaction history on Sepolia and Mainnet)
VITE_ETHERSCAN_API_KEY=
